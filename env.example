# Copy to .env and fill in:  cp env.example .env && chmod 600 .env
# Generate passwords with:    openssl rand -hex 24

COMPOSE_PROJECT_NAME=nextcloud
TZ=Europe/Amsterdam

# --- Image versions (pin Nextcloud to a major once running; upgrade one major at a time) ---
NEXTCLOUD_TAG=stable-apache
POSTGRES_TAG=17-alpine
REDIS_TAG=7-alpine

# --- Nextcloud ---
# Port on the VM where Nextcloud answers (http://VM-IP:8080)
NEXTCLOUD_PORT=8080
# Admin account and trusted domains are only used on the very first install
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme
# Space-separated addresses you open Nextcloud with (VM IP, later your domain)
NEXTCLOUD_TRUSTED_DOMAINS=192.168.0.202
# NFS mount of the NAS share (full path, no ~); owned by uid 33 (www-data)
NEXTCLOUD_DATA_PATH=/home/nextcloud/nextcloud-data
PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=16G

# --- Reverse proxy: leave empty without a proxy; see docs/CADDY-PROXY.md ---
# This setup: TRUSTED_PROXIES=192.168.0.201  OVERWRITEPROTOCOL=https
#             OVERWRITEHOST=nextcloud.dockerapp.org  OVERWRITECLIURL=https://nextcloud.dockerapp.org
TRUSTED_PROXIES=
OVERWRITEPROTOCOL=
OVERWRITEHOST=
OVERWRITECLIURL=

# --- Database ---
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=changeme

# --- Redis ---
REDIS_PASSWORD=changeme
