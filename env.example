# Copy to .env and fill in:  cp env.example .env && chmod 600 .env
# Generate secrets with:      openssl rand -base64 32

COMPOSE_PROJECT_NAME=nextcloud
TZ=Europe/Amsterdam

# --- Domain & certificates ---
DOMAIN=cloud.example.com
ACME_EMAIL=you@example.com
# Cloudflare API token: "Edit zone DNS" template, scoped to your zone
CF_API_TOKEN=changeme

# --- Exposure ---
# Option A (port forward): leave as 443
# Option B (Cloudflare Tunnel): set to 127.0.0.1:443 so nothing is exposed on the LAN/WAN
CADDY_HTTPS_BIND=443
# Only needed for Option B (Zero Trust > Tunnels > your tunnel > token)
CF_TUNNEL_TOKEN=

# Fixed subnet for the proxy network, also used as Nextcloud's trusted proxy
PROXY_SUBNET=172.30.0.0/24

# --- Image versions (pin a major for Nextcloud; upgrade one major at a time) ---
NEXTCLOUD_TAG=stable-apache
POSTGRES_TAG=17-alpine
REDIS_TAG=7-alpine

# --- Nextcloud ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme
# NFS mount of the NAS share (full path, no ~); owned by uid 33 / www-data
NEXTCLOUD_DATA_PATH=/home/nextcloud/nextcloud-data
PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=16G

# --- Database ---
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=changeme

# --- Redis ---
REDIS_PASSWORD=changeme
